ruby:
  tgt_date = session['tgt_date'] ? DateTime.parse(session['tgt_date'].to_s) : DateTime.now
.card
  .card-header
    h3.card-title
      = t('title.search_jobs')
  .card-body
    = form_with(model: @job, url: search_jobs_path, local: true) do |f|
      dl
        dt
          b
            = f.label :title
            | :
        dd
          = f.text_field :title
        dt
          b
            = f.label :detail
            | :
        dd
          = f.text_area :detail, size: "60x10"
        dt
        dd
          .actions
            = f.submit '検索'

    - if @jobs.count > 0
      table.table.table-striped.mt-3
        thead
          tr
            th
              = t('activerecord.attributes.job_type.name')
            th
              = t('activerecord.attributes.customer.short_name')
            th
              = t('activerecord.attributes.job.title')
            th
              = t('activerecord.attributes.job.detail')
            th
              = t('activerecord.attributes.job.outside_budget')
            th
              = t('activerecord.attributes.job.worktime')
            th
              = t('activerecord.attributes.job.begin_date')
            th
              = t('activerecord.attributes.job.end_date')
            th
        tbody
          - @jobs.each do |job|
            tr
              td
                = job.job_type.name
              td
                = job.customer.short_name
              td
                = job.title
              td
                = simple_format(job.detail)
              td
                = job.outside_budget
              td
                = sprintf( "%.3f", job.worktime )
              td
                = job.begin_date
              td
                = job.end_date
              td
                .btn-group
                  = link_to 'Show', job, class: "btn btn-secondary btn-sm"
                  = link_to 'Edit', edit_job_path(job), class: "btn btn-secondary btn-sm"
                  = link_to 'Destroy', job, class: "btn btn-danger btn-sm", data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }
    .btn-group.mt-2
      = link_to t('title.New_job'), new_job_path, class: "btn btn-secondary"
      - if @jobs.last.present?
        = link_to t('title.monthly_jobs_report'), {action: "report", begin_date: @jobs.last.begin_date}, class: "btn btn-secondary"
